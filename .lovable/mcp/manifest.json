        "name": "list_cities",
        "title": "List covered cities",
        "description": "List Indian cities and states covered by Local News. Optionally filter by a search term matching city or state name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional search term for city or state name."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum cities to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_city_news",
        "title": "Get city news",
        "description": "Get the latest published news stories for an Indian city covered by Local News, newest first. Returns bilingual headlines and summaries plus links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "City name, e.g. 'Alwar' or 'Jaipur'."
            },
            "category": {
              "type": "string",
              "description": "Optional category filter, e.g. Politics, Crime, Sports."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum stories to return (default 10, max 50)."
